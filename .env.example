# Example configuration. Copy to `.env` and adjust per environment.
# Never commit a real `.env`.

# Path to the serialised model bundle (relative paths resolve to project root).
CRM_ARTIFACT_PATH=artifacts/model_data.joblib

# dev | staging | production  (non-dev forces JSON logs)
CRM_APP_ENV=dev

# debug | info | warning | error
CRM_LOG_LEVEL=info

# Emit structured JSON logs instead of the console renderer.
CRM_LOG_JSON=false

# Scorecard calibration: score = CRM_BASE_SCORE + (1 - PD) * CRM_SCALE_LENGTH
# Defaults produce the CIBIL-like 300-900 range mandated by the SOW.
CRM_BASE_SCORE=300
CRM_SCALE_LENGTH=600

# Show the Straight-Through-Processing recommendation (SOW Phase 2 preview).
CRM_STP_ENABLED=true
